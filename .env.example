# =============================================================================
# ENV TEMPLATE — SISTEM INFORMASI PENJUALAN TOKO DONAT HABIL
# Salin file ini menjadi .env dan sesuaikan nilainya di lingkungan Anda.
# JANGAN PERNAH COMMIT FILE .env YANG BERISI KREDENSIAL NYATA!
# =============================================================================

# Koneksi PostgreSQL (Sesuaikan dengan compose.yaml untuk lokal, atau Neon untuk cloud)
# Format lokal: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://habib:local_dev_only_123@127.0.0.1:5432/web_app?schema=public"

# Kunci rahasia untuk menandatangani session cookie HMAC-SHA256 (Minimal 32 karakter)
# Buat string acak di terminal dengan perintah: openssl rand -base64 32
SESSION_SECRET="ganti-dengan-rahasia-acak-minimal-32-karakter-openssl"
